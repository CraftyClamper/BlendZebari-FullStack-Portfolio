@page "/"
@inject NavigationManager Router

<PageTitle>Blend Zebari | Fullstack .NET & E-Commerce Developer</PageTitle>

<!-- 🚀 PROFESSIONAL HERO BRAND LINE -->
<div class="bg-dark text-white py-5 px-4 mb-5 rounded-3 shadow-sm border-bottom border-primary border-3">
    <div class="container py-4 text-center">
        <span class="badge bg-success px-3 py-2 rounded-pill mb-3 text-uppercase tracking-wider fw-bold" style="font-size: 0.75rem;">
            🟢 Open for Freelance Gigs & Contract Development Roles
        </span>
        <h1 class="display-5 fw-bold mb-2" style="color: white;">Hi, I'm <span class="text-primary">Blend Zebari</span></h1>
        <h3 class="text-muted fw-light mt-1 fs-5">Fullstack Developer & Systems Engineer</h3>
        <p class="lead text-muted mx-auto my-4 fs-6" style="max-width: 700px; line-height: 1.6;">
            I specialize in building high-performance web applications, secure administration dashboards, background data ingestion scraping pipelines, and custom e-commerce custom layers using <strong>C#, Blazor, React, Node.js, and Chrome Extensions (Manifest V3)</strong>.
        </p>
        <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
            <button class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" @onclick='() => Router.NavigateTo("portfolio/bookmarks-vault")' type="button">
                📁 Explore Project Case Study
            </button>
            <a href="#fiverr-gigs" class="btn btn-outline-light rounded-pill px-4 fw-medium text-decoration-none d-flex align-items-center">
                ⚡ Order on Fiverr
            </a>
        </div>
    </div>
</div>

<div class="container my-5 text-dark">
    <!-- 🛠️ INTERACTIVE SKILLS BADGE MATRIX -->
    <div class="text-center mb-5">
        <h2 class="fw-bold">⚙️ Technical Ecosystem Stack</h2>
        <p class="text-muted small">Validated tech competencies applied across corporate systems and production solutions.</p>
        
        <div class="row row-cols-1 row-cols-md-3 g-3 mt-4 text-start">
            <div class="col">
                <div class="p-3 bg-light rounded-3 h-100 border shadow-sm">
                    <h6 class="fw-bold text-primary mb-2" style="font-size: 0.85rem;">Backend & API Layers</h6>
                    <div class="d-flex flex-wrap gap-1">
                        <span class="badge bg-dark extra-small">C#</span>
                        <span class="badge bg-dark extra-small">ASP.NET Core</span>
                        <span class="badge bg-dark extra-small">Node.js</span>
                        <span class="badge bg-dark extra-small">Express</span>
                        <span class="badge bg-dark extra-small">REST API Design</span>
                        <span class="badge bg-dark extra-small">SignalR Hubs</span>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="p-3 bg-light rounded-3 h-100 border shadow-sm">
                    <h6 class="fw-bold text-success mb-2" style="font-size: 0.85rem;">Frontend & E-Commerce</h6>
                    <div class="d-flex flex-wrap gap-1">
                        <span class="badge bg-dark extra-small">Blazor (Server/WASM)</span>
                        <span class="badge bg-dark extra-small">React</span>
                        <span class="badge bg-dark extra-small">TypeScript</span>
                        <span class="badge bg-dark extra-small">JavaScript (ES6+)</span>
                        <span class="badge bg-dark extra-small">HTML5 & CSS3</span>
                        <span class="badge bg-success extra-small text-white">Shopify Theme Dev</span>
                        <span class="badge bg-success extra-small text-white">WordPress / PHP</span>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="p-3 bg-light rounded-3 h-100 border shadow-sm">
                    <h6 class="fw-bold text-warning mb-2" style="font-size: 0.85rem;">Data & Specialized Logic</h6>
                    <div class="d-flex flex-wrap gap-1">
                        <span class="badge bg-dark extra-small">PostgreSQL</span>
                        <span class="badge bg-dark extra-small">SQLite / SQL</span>
                        <span class="badge bg-dark extra-small">EF Core</span>
                        <span class="badge bg-dark extra-small">Manifest V3 Extensions</span>
                        <span class="badge bg-dark extra-small">Web Scraping</span>
                        <span class="badge bg-dark extra-small">Formik & Yup</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 📊 MASTERY SHOWCASE MATRIX BRIDGE -->
    <div class="card p-4 border-0 shadow-sm bg-light rounded-3 my-5">
        <div class="row align-items-center g-4">
            <div class="col-lg-8 text-start">
                <span class="text-primary fw-bold text-uppercase small tracking-wide">Featured Project Ecosystem</span>
                <h3 class="fw-bold mt-1 text-dark">📚 An Enhanced Bookmark Manager</h3>
                <p class="text-muted small mb-3" style="line-height: 1.6;">
                    A cross-platform syncing network utilizing a custom-built Manifest V3 Google Chrome extension background client linked to a resilient ASP.NET Core Blazor web framework. Integrates multi-user collaboration hubs, background scraping models, and auto-hiding express parameters.
                </p>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold shadow-sm" @onclick='() => Router.NavigateTo("portfolio/bookmarks-vault")' type="button">
                        Read System Case Study →
                    </button>
                </div>
            </div>
            <div class="col-lg-4 text-center bg-white p-4 rounded border shadow-sm">
                <h5 class="fw-bold text-dark mb-1">Corporate Profile</h5>
                <p class="extra-small text-muted mb-3" style="line-height: 1.5;">Backed by an Information Systems degree and deployment history at Movz AB and Affordable Luxurys.</p>
                <button class="btn btn-sm btn-outline-dark w-100 rounded-pill fw-semibold" @onclick='() => Router.NavigateTo("resume")' type="button">Review Professional CV</button>
            </div>
        </div>
    </div>
